{
  "$defs": {
    "Objection": {
      "additionalProperties": false,
      "description": "One typed reason the critic refused the patch.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ObjectionKind",
          "description": "Objection category."
        },
        "message": {
          "description": "What the reviewer wants changed.",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "Objection",
      "type": "object"
    },
    "ObjectionKind": {
      "description": "Why the critic rejected a patch.",
      "enum": [
        "WRONG_ROOT_CAUSE",
        "UNSAFE_CODE",
        "DATA_LOSS_RISK",
        "WRONG_REMEDIATION_KIND",
        "MISSING_TEST",
        "OVER_BROAD_CHANGE",
        "OTHER"
      ],
      "title": "ObjectionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An independent reviewer's decision on one patch.\n\n``round`` is the Fix/Critic round and must be from 1 through 3.",
  "properties": {
    "approved": {
      "description": "Whether the reviewer accepts the patch.",
      "title": "Approved",
      "type": "boolean"
    },
    "critic_degraded": {
      "default": false,
      "description": "True when structured output failed. That is not a rejection.",
      "title": "Critic Degraded",
      "type": "boolean"
    },
    "objections": {
      "description": "Typed reasons the reviewer rejected the patch, if any.",
      "items": {
        "$ref": "#/$defs/Objection"
      },
      "title": "Objections",
      "type": "array"
    },
    "patch_id": {
      "description": "Patch under review.",
      "format": "uuid",
      "title": "Patch Id",
      "type": "string"
    },
    "reviewer_model": {
      "description": "Model that produced this verdict.",
      "title": "Reviewer Model",
      "type": "string"
    },
    "round": {
      "description": "Critic round, from 1 through 3.",
      "maximum": 3,
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    }
  },
  "required": [
    "patch_id",
    "reviewer_model",
    "approved",
    "round"
  ],
  "title": "Verdict",
  "type": "object"
}
