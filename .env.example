# Placeholder values only. Copy to .env and replace locally.
# Missing values do not crash import. Call Settings.require_anthropic(),
# Settings.require_xai(), or Settings.require_slack() at the point that needs them.

ANTHROPIC_API_KEY=your-anthropic-api-key
XAI_API_KEY=your-grok-api-key
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APPROVAL_CHANNEL=C0123456789
MERIDIAN_TRIAGE_PROVIDER=ollama
MERIDIAN_TRIAGE_MODEL=qwen3.5:27b-q4_K_M
MERIDIAN_ROOTCAUSE_PROVIDER=ollama
MERIDIAN_ROOTCAUSE_MODEL=qwen3.5:27b-q4_K_M
MERIDIAN_FIX_PROVIDER=ollama
MERIDIAN_FIX_MODEL=qwen3.5:27b-q4_K_M
MERIDIAN_CRITIC_PROVIDER=ollama
MERIDIAN_CRITIC_MODEL=gemma4:12b
MERIDIAN_LLM_SEED=42
MERIDIAN_TRIAGE_OMNIROUTE_MODEL=gemini/gemini-2.5-flash
MERIDIAN_ROOTCAUSE_OMNIROUTE_MODEL=gemini/gemini-2.5-flash
MERIDIAN_FIX_OMNIROUTE_MODEL=gemini/gemini-2.5-flash
MERIDIAN_CRITIC_OMNIROUTE_MODEL=gemini/gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
MERIDIAN_LLM_TIMEOUT_S=180
MERIDIAN_LLM_MAX_OUTPUT_TOKENS=2048
MERIDIAN_LLM_NUM_CTX=8192
MERIDIAN_RUN_WALL_BUDGET_S=900
MERIDIAN_MAX_MODEL_GB=26
MERIDIAN_ALLOW_PAID=0
MERIDIAN_MAX_USD_PER_RUN=0.25
MERIDIAN_MAX_USD_PER_DAY=1.00
MERIDIAN_ROOTCAUSE_MAX_TOOL_CALLS=8
MERIDIAN_SANDBOX_TIMEOUT_S=20
MERIDIAN_SANDBOX_MEMORY_MB=512
MERIDIAN_MAX_ROW_LOSS=0.01
MERIDIAN_MAX_QUARANTINE=0.25
MERIDIAN_MAX_OUTSIDE_CHANGE=0.0
MERIDIAN_PSI_MIN_ROWS=200
MERIDIAN_SLACK_APPROVERS=
MERIDIAN_APPROVAL_TIMEOUT_S=86400
MERIDIAN_CHECKPOINT_PATH=data/meridian-checkpoints.sqlite
MERIDIAN_CAPABILITIES_PATH=data/capabilities.json
RAY_NUM_CPUS=2
DATABASE_URL=postgresql://user:password@localhost:5432/meridian
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# MERIDIAN_TRACE=console
# An unset or unreachable DATABASE_URL keeps the audit log in data/audit/*.jsonl.
